{
  "name": "@evidencekit/citations",
  "version": "0.3.1",
  "description": "Deterministic, zero-dependency sentence-level citation checker for AI-generated text. Tells you which sentences are grounded in the evidence you supplied, which are uncited, and which cite an unknown or unsupported source, with no LLM judge required. Formerly grounding-kit.",
  "keywords": [
    "citation",
    "grounding",
    "hallucination",
    "rag",
    "llm",
    "fact-checking",
    "ai-safety",
    "sentence-splitter",
    "grounding-kit",
    "evidence-kit",
    "evidencekit"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidencekit/citations.git"
  },
  "homepage": "https://github.com/evidencekit/citations#readme",
  "bugs": {
    "url": "https://github.com/evidencekit/citations/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
